DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DECISION_MODE=replay          # live | record | replay
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=                  # o 9ROUTER_API_KEY en el entorno
LLM_MODEL=gh/claude-haiku-5.5
LLM_TIMEOUT=60
LLM_PRICE_IN_PER_1M=1.0       # precio de referencia (Claude Haiku) para medir costo "si fuera pago"
LLM_PRICE_OUT_PER_1M=5.0
# Opcionales (solo para actualizar datos o publicar modelos; la demo corre sin ellos)
APIFY_TOKEN=                  # collect: Instagram/TikTok públicos vía Apify
HF_TOKEN=                     # push_model_hf: subir el modelo a Hugging Face
AUTO_THRESHOLD=0.80           # umbral Recomendar
REVIEW_THRESHOLD=0.50         # umbral Aprender
# System One (Jev): mismo contrato POST /v1/systemone. Abierto y local: `pip install von-sdk && von serve --port 8801`.
SYSTEMONE_URL=http://127.0.0.1:8801/v1/systemone   # Jev real: https://api.typesafe.ai/v1/systemone + SYSTEMONE_API_KEY
SYSTEMONE_API_KEY=            # solo con Jev de TypeSafe; Von local no la pide
SYSTEMONE_TIMEOUT=30          # Von en CPU tarda ~7 s por pieza
